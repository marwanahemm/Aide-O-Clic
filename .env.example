# --- MODE DÉMO (actif tant que cette variable n'est pas "false") ---
# En démo : site non référencé, aucune donnée enregistrée, aucune autre variable nécessaire.
# Pour ouvrir le site au public (après SIRET + n° SAP) : MODE_DEMO=false
# ATTENTION : les pages sont générées au build → définir MODE_DEMO=false AUSSI au moment du build
# (ex. `MODE_DEMO=false npm run deploy`, ou « variable de build » dans Cloudflare), pas seulement à l'exécution.
# MODE_DEMO=false

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://dyhrgbopcnukhpdrybrm.supabase.co
# Clé "service_role" : SECRÈTE, uniquement côté serveur (ne jamais préfixer par NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImR5aHJnYm9wY251a2hwZHJ5YnJtIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MDg3NjMxMSwiZXhwIjoyMTA2NDUyMzExfQ.SaJf2KnaTD7vd_-UXTi_pKKCSTEYCeIGGyMEo_w801U

# --- Notification par e-mail (Resend) : optionnel, désactivée si vide ---
RESEND_API_KEY=
# Adresse qui reçoit les notifications. Avec l'expéditeur de test (onboarding@resend.dev),
# ce doit être l'adresse e-mail de TON COMPTE Resend.
NOTIFY_EMAIL=
# Optionnel : expéditeur personnalisé, uniquement si tu as vérifié un domaine dans Resend
# MAIL_FROM : expéditeur des e-mails, sur un domaine VÉRIFIÉ dans Resend (ex. Aide O'Clic <rdv@aide-o-clic.fr>).
# Obligatoire pour envoyer la confirmation de rendez-vous aux clients : sans lui, seuls les e-mails qui t'avertissent partent.
# MAIL_FROM=Aide O'Clic <rdv@aide-o-clic.fr>

# --- Purge automatique RGPD (Cron Trigger Cloudflare, 03h00 UTC — voir wrangler.jsonc) ---
# Génère une valeur longue : openssl rand -hex 32
CRON_SECRET=

# --- Back-office /admin ---
# Mot de passe de l'espace admin : 12 caractères minimum (idéalement une phrase de passe longue). SECRET.
# Sans cette variable, /admin affiche simplement « non configuré ».
ADMIN_PASSWORD=ADE+23VB78c6
